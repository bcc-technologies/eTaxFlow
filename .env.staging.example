# Staging / pre-certification environment example (PLACEHOLDERS ONLY)
#
# WARNING:
# - Do NOT commit a real .env file with secrets, certificates, or private keys.
# - Do NOT enable public DGII endpoints without human approval.
# - Do NOT use production URLs or production signing in staging/pre-cert.
# - Copy to .env.staging locally and fill via approved secret manager only.

DEBUG=false

# Staging/pre-cert host only — NOT production.
# Example when approved: https://etaxflow.bcctechnologies.com.do
ALLOWED_HOSTS=etaxflow.bcctechnologies.com.do,localhost,127.0.0.1

# Placeholder — inject via secret manager; never commit real values.
SECRET_KEY=
DATABASE_URL=
MEDIA_ROOT=/srv/etaxflow-staging/media

# HTTPS staging (enable only after TLS is verified on staging host)
CSRF_TRUSTED_ORIGINS=https://etaxflow.bcctechnologies.com.do
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Use HSTS cautiously on staging; confirm with security owner before production parity.
SECURE_HSTS_SECONDS=0

# Phase 025/026 — software registration metadata (design defaults)
ETAXFLOW_SOFTWARE_NAME=eTaxFlow
ETAXFLOW_SOFTWARE_VERSION=0.1.0
ETAXFLOW_SOFTWARE_TYPE=PROPIO

# Leave blank until DNS/SSL/staging deployment is human-approved.
ETAXFLOW_PUBLIC_BASE_URL=
# Must remain false until security + tax/compliance sign-off.
ETAXFLOW_ENABLE_PUBLIC_DGII_ENDPOINTS=false

# Legacy DGII placeholders — mock/offline only; no live transport
DGII_ENVIRONMENT=MOCK
DGII_SOFTWARE_NAME=eTaxFlow
DGII_SOFTWARE_VERSION=0.1.0
DGII_SOFTWARE_TYPE=PROPIO
DGII_URL_AUTENTICACION=
DGII_URL_RECEPCION=
DGII_URL_APROBACION_COMERCIAL=
DGII_LIVE_TRANSPORT_ENABLED=false

# Signing remains disabled — no certificate paths in repo
SIGNING_MODE=DISABLED
SIGNING_BACKEND=NONE
SIGNING_ENABLED=false
SIGNING_ALLOW_TEST_ONLY=false
SIGNING_CERT_PATH=
SIGNING_KEY_PATH=
SIGNING_PASS_ENV_VAR=
